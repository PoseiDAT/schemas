{
  "name": "@poseidat/schemas",
  "version": "0.1.0",
  "description": "The core schemas for the PoseiDAT data interchange formats",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "scripts": {
    "build:clean": "rm -rf lib/schema",
    "build:compile": "tsc -b --verbose",
    "build:copy-schema": "cp -r src/schema lib",
    "build:docs": "rm -rf docs/schemas && jsonschema2md -x docs/schemas -e json -d src/schema -o docs",
    "build": "npm-run-all build:clean build:compile build:copy-schema build:docs",
    "clean": "rimraf lib",
    "docs:serve": "docsify serve docs",
    "docs": "npm-run-all build:docs docs:serve",
    "generate:json-schema": "tsx scripts/generate-json-schema.ts",
    "lint": "eslint .",
    "prepare": "npm run build",
    "rebuild": "npm-run-all clean build:compile",
    "typecheck": "tsc -p tsconfig.spec.json --pretty false",
    "test:generated-fresh": "git diff --exit-code -- generated/json-schema",
    "test:jest": "jest --silent --coverage test/",
    "test": "npm-run-all generate:json-schema test:generated-fresh typecheck test:jest",
    "watch": "tsc -b src/ --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PoseiDAT/schemas.git"
  },
  "keywords": [
    "PoseiDAT",
    "maritime",
    "fishing",
    "scientific",
    "ERS"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PoseiDAT/schemas/issues"
  },
  "homepage": "https://github.com/PoseiDAT/schemas#readme",
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "devDependencies": {
    "@adobe/jsonschema2md": "^6.1.4",
    "@commitlint/cli": "^13.2.1",
    "@commitlint/config-conventional": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.0",
    "@types/uuid": "^8.3.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "docsify-cli": "^4.4.3",
    "eslint": "^9.39.5",
    "husky": "^7.0.2",
    "jest": "^30.5.1",
    "lint-staged": "^11.2.3",
    "npm-run-all": "^4.1.5",
    "rimraf": "^3.0.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.3.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "uuid": "^8.3.2"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
